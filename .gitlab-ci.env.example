# GitLab CI/CD Environment Variables
# Copy these to your GitLab project's CI/CD variables

# API Keys (Required for data collection)
OPENAI_API_KEY=your_openai_api_key_here
BRAVE_API_KEY=your_brave_search_api_key_here
# BING_API_KEY=your_bing_api_key_here  # Optional

# Supabase Database Connection (Required)
# Add your Supabase connection string here
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
STORAGE_URL=your_supabase_connection_string_here

# Scheduler Configuration
SCHEDULER_RUN_ON_START=false
SCHEDULER_CRON_EXPRESSION=0 * * * *
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_DELAY_MS=10000
SCHEDULER_MANUAL_AUDIT_PERCENT=5

# Collector Configuration
COLLECTOR_OUTPUT_DIR=data/serp
COLLECTOR_MAX_RESULTS=20
COLLECTOR_USER_AGENT=TruthLayerBot/0.1 (https://truthlayer.ai)
COLLECTOR_RESPECT_ROBOTS=true
COLLECTOR_ROBOTS_CACHE_TTL_MS=3600000
COLLECTOR_CACHE_TTL_DAYS=7

# Annotation Configuration
ANNOTATION_MODEL=gpt-4o-mini
ANNOTATION_PROVIDER=openai
ANNOTATION_CONFIDENCE_DEFAULT=0.7
ANNOTATION_BATCH_SIZE=10
ANNOTATION_MAX_CONCURRENCY=3

# Metrics Configuration
METRICS_EXPORT_DIR=data/metrics
METRICS_WINDOW_SIZE=7

# Rate Limiting
BRAVE_RATE_LIMIT_RPS=1
PERPLEXITY_RATE_LIMIT_RPS=2

# Runtime Configuration
NODE_ENV=production
FORCE_REFRESH=false
